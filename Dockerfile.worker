FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Healthcheck: worker touches /tmp/worker_alive on every poll loop.
# Docker (and Render/Fly/etc.) uses this to detect a hung worker.
HEALTHCHECK --interval=60s --timeout=10s --start-period=90s --retries=3 \
    CMD python -c "import os, time; f='/tmp/worker_alive'; exit(0 if os.path.exists(f) and time.time()-os.path.getmtime(f)<120 else 1)"

CMD ["python", "worker.py"]
